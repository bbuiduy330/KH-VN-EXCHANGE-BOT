datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  WAITING_PAYMENT
  CUSTOMER_SENT_BILL
  WAITING_ADMIN_VERIFY
  PAYMENT_CONFIRMED
  WAITING_PAYOUT
  PAYOUT_SENT
  COMPLETED
  CANCELLED
  PAYMENT_MISMATCH
  MANUAL_REVIEW
  SUSPICIOUS
}

enum ConversationMode {
  AUTO
  HUMAN
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  CSKH
}

enum StaffStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum QuoteStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model ExchangeRate {
  id          String   @id @default(cuid())
  pair        String   @unique
  baseRate    Decimal  @db.Decimal(18, 6)
  buyMargin   Decimal  @db.Decimal(18, 6)
  sellMargin  Decimal  @db.Decimal(18, 6)
  fee         Decimal  @db.Decimal(18, 6)
  feeCurrency String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceCurrency String
  targetCurrency String
  sourceAmount   Decimal     @db.Decimal(18, 6)
  targetAmount   Decimal     @db.Decimal(18, 6)
  effectiveRate  Decimal     @db.Decimal(18, 6)
  baseRate       Decimal     @db.Decimal(18, 6)
  fee            Decimal     @db.Decimal(18, 6)
  feeCurrency    String
  // TRANSPARENT QUOTE BREAKDOWN — ADDITIVE, all nullable (NULL ⇒ legacy quote,
  // rendered by the legacy compact card; historical financial amounts are never
  // rewritten). Freezes WHICH side the customer fixed and the AUTHORITATIVE
  // display rate, so a later render never derives the rate from
  // sourceAmount/targetAmount (the fee + rounding make that ratio wrong).
  rateSide         String?
  displayRate      Decimal? @db.Decimal(18, 6)
  conversionUsd    Decimal? @db.Decimal(18, 6)
  feeUsd           Decimal? @db.Decimal(18, 6)
  payerAmountExact Decimal? @db.Decimal(18, 6)
  status         QuoteStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime    @default(now())

  @@index([customerId, status])
  @@index([expiresAt])
}

model PaymentAccount {
  id            String                  @id @default(cuid())
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  tag           String                  @default("default")
  qrFileId      String?
  qrFilePath    String?
  qrSha256      String?
  qrVersion     Int                     @default(1)
  isDefault     Boolean                 @default(false)
  priority      Int                     @default(0)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  versions      PaymentAccountVersion[]
  // --- Dynamic payment QR V1 (additive, nullable — STATIC rows stay valid) ---
  // STATIC (default behavior) | KHQR (USD/Bakong) | VIETQR (VND/NAPAS)
  qrProvider            String?
  // VietQR: NAPAS bank BIN (authoritative — never derived from bankName)
  bankBin               String?
  // KHQR mode: INDIVIDUAL | MERCHANT (fields required differ per official SDK)
  khqrMode              String?
  khqrBakongAccountId   String?
  khqrMerchantName      String?
  // F1/F9 — automated incoming-payment verification provider for THIS account.
  // null/empty = DISABLED (manual Admin verification only). Secrets (API
  // tokens) live in the encrypted system-secret mechanism, never here.
  verificationProvider  String?
  verificationBaseUrl   String?
  khqrMerchantCity      String?
  khqrMerchantId        String?
  khqrAcquiringBank     String?

  @@index([currency, isActive])
  @@index([isDefault])
}

model PaymentAccountVersion {
  id               String         @id @default(cuid())
  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  version          Int
  qrFileId         String
  qrFilePath       String
  qrSha256         String
  createdBy        String
  createdAt        DateTime       @default(now())

  @@unique([paymentAccountId, version])
  @@index([paymentAccountId])
}

model Customer {
  id                String               @id @default(cuid())
  telegramId        String               @unique
  username          String?
  fullName          String?
  phone             String?
  language          String               @default("vi")
  // Broadcast/marketing reachability (C9/C2): marketing opt-out suppresses
  // ONLY Broadcast campaigns — never order/payment/payout/support messages.
  marketingEnabled  Boolean              @default(true)
  telegramReachable Boolean              @default(true)
  // TRUE customer-facing activity timestamp (inbound message / support request /
  // order initiation) — maintained by CustomerChatHistoryService + order flow.
  // NEVER touched by Admin profile views, audits or schedulers.
  lastActivityAt    DateTime             @default(now())
  // Partner/CTV attribution (S/T): nullable, assigned only via referral claim
  // or Admin reassignment; NEVER overwritten by a second referral link.
  partnerId         String?
  partnerAssignedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  payoutBanks       CustomerPayoutBank[]
  orders            Order[]
  quotes            Quote[]
  conversation      Conversation?
  chatMessages      CustomerChatMessage[]

  // Admin customer list — keyset (lastActivityAt DESC, id DESC) pagination:
  @@index([lastActivityAt, id])
  @@index([updatedAt, id])
}

model CustomerPayoutBank {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                       String              @id @default(cuid())
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  // T — immutable attribution snapshot taken at Order creation; history never
  // changes even if the customer's assignment is later corrected by Admin.
  partnerId                String?
  // FROZEN PAYMENT DATA (dynamic QR V1): memo generated ONCE at Order
  // creation from the then-current template; later template changes never
  // rewrite an existing Order's payment instructions.
  transferMemo             String?
  // E6 — FROZEN rate/margin basis captured at Order creation from the
  // authoritative ExchangeRate row (baseRate + buy/sellMargin). Commission
  // spread math uses THIS snapshot — never current live rates.
  rateMarginSnapshot       Json?
  // F5 — Bakong Open API MD5 of THIS Order's dynamic KHQR (nullable).
  khqrMd5                  String?
  sourceCurrency           String
  targetCurrency           String
  sourceAmount             Decimal             @db.Decimal(18, 6)
  targetAmount             Decimal             @db.Decimal(18, 6)
  rate                     Decimal             @db.Decimal(18, 6)
  fee                      Decimal             @db.Decimal(18, 6)
  feeCurrency              String
  receivingAccountId       String?
  receivingAccountSnapshot Json?
  payoutBankSnapshot       Json?
  status                   OrderStatus         @default(WAITING_PAYMENT)
  // CANONICAL PUBLIC ORDER REFERENCE — unique, immutable, human-friendly.
  // Generated once at creation (UPPER last-6 preferred); never rewritten.
  // transferMemo is the BANK matching reference — NOT an Order ref.
  publicRef                String?
  customerBillFileId       String?
  customerBillSha256       String?
  aiExtractedData          Json?
  payoutBillFileId         String?
  payoutBillSha256         String?
  verifiedByAdminId        String?
  verifiedAt               DateTime?
  payoutByAdminId          String?
  payoutAt                 DateTime?
  completedAt              DateTime?
  storageFolder            String?
  archiveStatus            String?             @default("PENDING")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  stateHistories           OrderStateHistory[]
  bills                    OrderBillEvidence[]

  @@index([status])
  @@index([customerId])
  @@index([partnerId])
  // Admin scalable lists — keyset (createdAt DESC, id DESC) pagination:
  @@index([createdAt, id])
  @@index([status, createdAt])
}

model OrderStateHistory {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  actorId    String
  actorRole  String
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model OrderBillEvidence {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId     String
  filePath   String
  sha256     String
  extracted  Json?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([sha256])
}

model Conversation {
  id          String           @id @default(cuid())
  customerId  String           @unique
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  // Order-linked support context (nullable): set when a support request starts
  // from a specific Order — 📦 Mở đơn routing + transcript rows keep it.
  orderId     String?
  mode        ConversationMode @default(AUTO)
  claimedById String?
  claimedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    Message[]
  notes       InternalNote[]
}

model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType          String       // CUSTOMER, AI, BOT, CSKH, ADMIN, SYSTEM
  senderId            String?
  content             String
  originalAudioFileId String?
  originalAudioSha256 String?
  translatedContent   String?
  deliveryStatus      String       @default("SENT") // PENDING, SENT, FAILED
  telegramMessageId   Int?
  deliveryError       String?
  createdAt           DateTime     @default(now())

  @@index([conversationId])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
}

model StaffUser {
  id          String      @id @default(cuid())
  telegramId  String      @unique
  name        String
  role        StaffRole   @default(CSKH)
  status      StaffStatus @default(PENDING)
  permissions String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())

  // Admin activity feed — keyset (createdAt DESC, id DESC) pagination:
  @@index([createdAt, id])
}

model FileEvidence {
  id                  String   @id @default(cuid())
  fileName            String
  filePath            String
  storageRelativePath String?
  fileType            String
  fileSize            Int
  mimeType            String
  sha256              String
  createdAt           DateTime @default(now())

  @@index([sha256])
}

model StaffInvite {
  id                  String    @id @default(cuid())
  code                String    @unique
  role                StaffRole @default(CSKH)
  createdBy           String
  claimedByTelegramId String?
  claimedByName       String?
  status              String    @default("PENDING")
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BackupRun {
  id             String    @id @default(cuid())
  requestedBy    String    @default("SYSTEM")
  requestedAt    DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  status         String    @default("QUEUED") // QUEUED, RUNNING, SUCCESS, FAILED
  snapshotId     String?
  backupType     String    @default("FULL")
  repositoryType String    @default("RESTIC")
  filesCount     Int?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model SystemSecret {
  id             String   @id @default(cuid())
  key            String   @unique
  encryptedValue String
  iv             String
  authTag        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInputSession {
  id        String   @id @default(cuid())
  staffId   String   @unique
  action    String
  step      String
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([expiresAt])
}

// ===========================================================================
// Partner / CTV core (S–W). Attribution-only: Partners NEVER see customer
// financial/private data. Commissions are created idempotently on COMPLETED
// orders (unique orderId) and settled in Admin batches.
// ===========================================================================
model Partner {
  id                  String              @id @default(cuid())
  referralCode        String              @unique
  telegramId          String?             @unique
  displayName         String
  status              String              @default("ACTIVE") // ACTIVE | DISABLED
  // Commission configuration (U). spreadSharePercent is reserved for the
  // DEFERRED spread bonus; commission engine currently applies base only.
  baseCommissionUsd   Decimal             @default(1) @db.Decimal(18, 6)
  spreadSharePercent  Decimal             @default(0) @db.Decimal(9, 4)
  holdHours           Int                 @default(72)
  // Partner's OWN payout metadata (safe — this is partner money, not
  // customer data).
  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountName   String?
  // V2 free-form payout destination + reference QR image (FileEvidence id).
  // Reference information only — Admin manually reviews and pays.
  payoutDestinationText String?
  payoutQrFileId        String?
  // CTV UI language: "vi" | "en" (NULL = picker shown on next /ctv).
  // Independent from Customer.language — one person may be a km customer
  // and an en partner. Never inferred from customer locale.
  language              String?
  // E1 — 5-level CTV hierarchy (L2..L5 upline). Commission originates ONLY
  // from real COMPLETED customer Orders — never for recruiting.
  parentPartnerId String?
  parent          Partner?           @relation("PartnerHierarchy", fields: [parentPartnerId], references: [id])
  children        Partner[]          @relation("PartnerHierarchy")
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  commissions         Commission[]
  settlements         PartnerSettlement[]

  // Admin CTV list — keyset (createdAt DESC, id DESC) pagination:
  @@index([createdAt, id])
}

// ===========================================================================
// DURABLE CUSTOMER CHAT TRANSCRIPT (Part 2 — operations pass).
// Metadata-only transcript of CUSTOMER-FACING conversation content. Audit log
// is a technical record — this is the operational transcript. Survives
// AUTO↔HUMAN support transitions (claim/release never erase history).
// Media is stored as Telegram file_id metadata ONLY — never binaries, never
// secrets. Dedupe on (telegramChatId, telegramMessageId, direction).
// ===========================================================================
model CustomerChatMessage {
  id               String   @id @default(cuid())
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  conversationId   String?
  telegramChatId   String
  telegramMessageId String?
  direction        String // INBOUND | OUTBOUND
  senderType       String // CUSTOMER | BOT | STAFF | SYSTEM
  staffTelegramId  String?
  contentType      String   @default("TEXT") // TEXT | PHOTO | DOCUMENT | VOICE | VIDEO | STICKER | OTHER
  text             String?
  caption          String?
  telegramFileId   String?
  // Nullable Order context (set when the support session is Order-linked).
  orderId          String?
  createdAt        DateTime @default(now())

  @@index([customerId, createdAt, id])
  @@index([orderId, createdAt])
  @@unique([telegramChatId, telegramMessageId, direction])
}

model Commission {
  id                String            @id @default(cuid())
  // MULTI-LEVEL (E7): multiple Commission rows per Order (one per upline
  // Partner level). Composite identity (orderId, partnerId, level).
  orderId           String
  level             Int               @default(1)
  partnerId         String
  partner           Partner           @relation(fields: [partnerId], references: [id])
  // Fixed tier component of THIS level (E2).
  baseCommissionUsd Decimal           @db.Decimal(18, 6)
  // L1 only: 20% of the commissionable FX spread (E2/E3); 0 for L2-L5.
  spreadBonusUsd    Decimal           @default(0) @db.Decimal(18, 6)
  totalUsd          Decimal           @db.Decimal(18, 6)
  status            String            @default("HELD") // HELD | AVAILABLE | PAID | REVERSED
  availableAt       DateTime?
  riskFlag          String?
  settlementId      String?
  settlement        PartnerSettlement? @relation(fields: [settlementId], references: [id])
  paidAt            DateTime?
  reversedReason    String?
  // E6 — FROZEN commission snapshot: hierarchy used, rule version, spread
  // basis. Later Partner-parent changes NEVER rewrite past commissions.
  ruleVersion       String?
  hierarchySnapshot Json?
  spreadBasis       Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@unique([orderId, partnerId, level])
  @@index([partnerId, status])
  // Per-CTV commission list — keyset (createdAt DESC, id DESC) pagination:
  @@index([partnerId, createdAt, id])
}

model PartnerSettlement {
  id          String       @id @default(cuid())
  partnerId   String
  partner     Partner      @relation(fields: [partnerId], references: [id])
  totalUsd    Decimal      @db.Decimal(18, 6)
  itemCount   Int
  status      String       @default("PENDING") // PENDING | PAID
  paidAt      DateTime?
  createdBy   String
  note        String?
  // FROZEN destination used for THIS settlement (never retroactively changed
  // when the Partner later edits their payout information).
  payoutDestinationSnapshot Json?
  // Admin payout proof (FileEvidence id) — reference only, Admin action
  // (markSettlementPaid) remains the authoritative financial verification.
  payoutProofFileId String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  commissions Commission[]
}

// ---------------------------------------------------------------------------
// Broadcast / customer outreach (Part C) — additive only.
// Audience is SNAPSHOTTED into BroadcastRecipient rows BEFORE sending so the
// campaign target can never change midway. No Telegram secrets are stored.
// ---------------------------------------------------------------------------
model BroadcastCampaign {
  id                  String    @id @default(cuid())
  title               String?
  createdByTelegramId String
  // DRAFT | READY | SENDING | COMPLETED | CANCELLED | FAILED (String-status
  // convention, consistent with the rest of the project).
  status              String    @default("DRAFT")
  // ALL | FILTER | LIST | ONE_CUSTOMER
  audienceType        String
  audienceFilter      Json?
  content             Json
  totalRecipients     Int       @default(0)
  sentCount           Int       @default(0)
  failedCount         Int       @default(0)
  blockedCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  confirmedAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  recipients          BroadcastRecipient[]
}

model BroadcastRecipient {
  id         String            @id @default(cuid())
  campaignId String
  campaign   BroadcastCampaign @relation(fields: [campaignId], references: [id])
  customerId String
  // Snapshot at snapshot-time (never re-resolved mid-campaign):
  telegramId String
  locale     String?
  // PENDING | SENT | FAILED | BLOCKED
  status     String            @default("PENDING")
  attempts   Int               @default(0)
  lastError  String?
  sentAt     DateTime?
  createdAt  DateTime          @default(now())

  @@unique([campaignId, customerId])
  @@index([campaignId, status])
}

// F2 — durable inbound-payment event model (provider-neutral). Unique per
// (provider, externalTransactionId) for webhook/lookup deduplication. NEVER
// stores API secrets/tokens — secrets live in the encrypted system-secret
// mechanism; rawMetadata holds sanitized provider data only.
model IncomingPaymentEvent {
  id                    String    @id @default(cuid())
  provider              String // BAKONG_OPEN_API | ABA_PAYWAY | SEPAY | APIPAY
  externalTransactionId String
  paymentAccountId      String?
  matchedOrderId        String?
  currency              String?
  amount                Decimal?  @db.Decimal(18, 6)
  memo                  String?
  // RECEIVED | MATCHED | CONFIRMED | MISMATCH | IGNORED | FAILED
  status                String    @default("RECEIVED")
  rawMetadata           Json?
  receivedAt            DateTime  @default(now())
  verifiedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@unique([provider, externalTransactionId])
  @@index([status, receivedAt])
}
