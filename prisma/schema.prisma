datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  WAITING_PAYMENT
  CUSTOMER_SENT_BILL
  WAITING_ADMIN_VERIFY
  PAYMENT_CONFIRMED
  WAITING_PAYOUT
  PAYOUT_SENT
  COMPLETED
  CANCELLED
  PAYMENT_MISMATCH
  MANUAL_REVIEW
  SUSPICIOUS
}

enum ConversationMode {
  AUTO
  HUMAN
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  CSKH
}

enum StaffStatus {
  PENDING
  ACTIVE
  DISABLED
}

model ExchangeRate {
  id          String   @id @default(cuid())
  pair        String   @unique
  baseRate    Decimal  @db.Decimal(18, 6)
  buyMargin   Decimal  @db.Decimal(18, 6)
  sellMargin  Decimal  @db.Decimal(18, 6)
  fee         Decimal  @db.Decimal(18, 6)
  feeCurrency String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PaymentAccount {
  id            String                  @id @default(cuid())
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  tag           String                  @default("default")
  qrFileId      String?
  qrFilePath    String?
  qrSha256      String?
  qrVersion     Int                     @default(1)
  isDefault     Boolean                 @default(false)
  priority      Int                     @default(0)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  versions      PaymentAccountVersion[]

  @@index([currency, isActive])
  @@index([isDefault])
}

model PaymentAccountVersion {
  id               String         @id @default(cuid())
  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  version          Int
  qrFileId         String
  qrFilePath       String
  qrSha256         String
  createdBy        String
  createdAt        DateTime       @default(now())

  @@unique([paymentAccountId, version])
  @@index([paymentAccountId])
}

model Customer {
  id           String               @id @default(cuid())
  telegramId   String               @unique
  username     String?
  fullName     String?
  phone        String?
  language     String               @default("vi")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  payoutBanks  CustomerPayoutBank[]
  orders       Order[]
  conversation Conversation?
}

model CustomerPayoutBank {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                       String              @id @default(cuid())
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  sourceCurrency           String
  targetCurrency           String
  sourceAmount             Decimal             @db.Decimal(18, 6)
  targetAmount             Decimal             @db.Decimal(18, 6)
  rate                     Decimal             @db.Decimal(18, 6)
  fee                      Decimal             @db.Decimal(18, 6)
  feeCurrency              String
  receivingAccountId       String?
  receivingAccountSnapshot Json?
  payoutBankSnapshot       Json?
  status                   OrderStatus         @default(WAITING_PAYMENT)
  customerBillFileId       String?
  customerBillSha256       String?
  aiExtractedData          Json?
  payoutBillFileId         String?
  payoutBillSha256         String?
  verifiedByAdminId        String?
  verifiedAt               DateTime?
  payoutByAdminId          String?
  payoutAt                 DateTime?
  completedAt              DateTime?
  storageFolder            String?
  archiveStatus            String?             @default("PENDING")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  stateHistories           OrderStateHistory[]
  bills                    OrderBillEvidence[]

  @@index([status])
  @@index([customerId])
}

model OrderStateHistory {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  actorId    String
  actorRole  String
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model OrderBillEvidence {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId     String
  filePath   String
  sha256     String
  extracted  Json?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([sha256])
}

model Conversation {
  id          String           @id @default(cuid())
  customerId  String           @unique
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mode        ConversationMode @default(AUTO)
  claimedById String?
  claimedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    Message[]
  notes       InternalNote[]
}

model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType          String
  senderId            String?
  content             String
  originalAudioFileId String?
  originalAudioSha256 String?
  translatedContent   String?
  createdAt           DateTime     @default(now())
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
}

model StaffUser {
  id          String      @id @default(cuid())
  telegramId  String      @unique
  name        String
  role        StaffRole   @default(CSKH)
  status      StaffStatus @default(PENDING)
  permissions String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model FileEvidence {
  id                  String   @id @default(cuid())
  fileName            String
  filePath            String
  storageRelativePath String?
  fileType            String
  fileSize            Int
  mimeType            String
  sha256              String
  createdAt           DateTime @default(now())

  @@index([sha256])
}

model StaffInvite {
  id                  String    @id @default(cuid())
  code                String    @unique
  role                StaffRole @default(CSKH)
  createdBy           String
  claimedByTelegramId String?
  claimedByName       String?
  status              String    @default("PENDING")
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BackupRun {
  id         String    @id @default(cuid())
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  status     String    @default("RUNNING")
  snapshotId String?
  filesCount Int?
  error      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

model SystemSecret {
  id             String   @id @default(cuid())
  key            String   @unique
  encryptedValue String
  iv             String
  authTag        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String
}
