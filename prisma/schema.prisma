datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum OrderStatus {
  WAITING_PAYMENT
  CUSTOMER_SENT_BILL
  WAITING_ADMIN_VERIFY
  PAYMENT_CONFIRMED
  WAITING_PAYOUT
  PAYOUT_SENT
  COMPLETED
  CANCELLED
  PAYMENT_MISMATCH
  MANUAL_REVIEW
  SUSPICIOUS
}

enum ConversationMode {
  AUTO
  HUMAN
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  CSKH
}

enum StaffStatus {
  PENDING
  ACTIVE
  DISABLED
}

enum QuoteStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

model ExchangeRate {
  id          String   @id @default(cuid())
  pair        String   @unique
  baseRate    Decimal  @db.Decimal(18, 6)
  buyMargin   Decimal  @db.Decimal(18, 6)
  sellMargin  Decimal  @db.Decimal(18, 6)
  fee         Decimal  @db.Decimal(18, 6)
  feeCurrency String
  updatedBy   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Quote {
  id             String      @id @default(cuid())
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  sourceCurrency String
  targetCurrency String
  sourceAmount   Decimal     @db.Decimal(18, 6)
  targetAmount   Decimal     @db.Decimal(18, 6)
  effectiveRate  Decimal     @db.Decimal(18, 6)
  baseRate       Decimal     @db.Decimal(18, 6)
  fee            Decimal     @db.Decimal(18, 6)
  feeCurrency    String
  status         QuoteStatus @default(PENDING)
  expiresAt      DateTime
  confirmedAt    DateTime?
  createdAt      DateTime    @default(now())

  @@index([customerId, status])
  @@index([expiresAt])
}

model PaymentAccount {
  id            String                  @id @default(cuid())
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  tag           String                  @default("default")
  qrFileId      String?
  qrFilePath    String?
  qrSha256      String?
  qrVersion     Int                     @default(1)
  isDefault     Boolean                 @default(false)
  priority      Int                     @default(0)
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  versions      PaymentAccountVersion[]
  // --- Dynamic payment QR V1 (additive, nullable — STATIC rows stay valid) ---
  // STATIC (default behavior) | KHQR (USD/Bakong) | VIETQR (VND/NAPAS)
  qrProvider            String?
  // VietQR: NAPAS bank BIN (authoritative — never derived from bankName)
  bankBin               String?
  // KHQR mode: INDIVIDUAL | MERCHANT (fields required differ per official SDK)
  khqrMode              String?
  khqrBakongAccountId   String?
  khqrMerchantName      String?
  khqrMerchantCity      String?
  khqrMerchantId        String?
  khqrAcquiringBank     String?

  @@index([currency, isActive])
  @@index([isDefault])
}

model PaymentAccountVersion {
  id               String         @id @default(cuid())
  paymentAccountId String
  paymentAccount   PaymentAccount @relation(fields: [paymentAccountId], references: [id], onDelete: Cascade)
  version          Int
  qrFileId         String
  qrFilePath       String
  qrSha256         String
  createdBy        String
  createdAt        DateTime       @default(now())

  @@unique([paymentAccountId, version])
  @@index([paymentAccountId])
}

model Customer {
  id                String               @id @default(cuid())
  telegramId        String               @unique
  username          String?
  fullName          String?
  phone             String?
  language          String               @default("vi")
  // Partner/CTV attribution (S/T): nullable, assigned only via referral claim
  // or Admin reassignment; NEVER overwritten by a second referral link.
  partnerId         String?
  partnerAssignedAt DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  payoutBanks       CustomerPayoutBank[]
  orders            Order[]
  quotes            Quote[]
  conversation      Conversation?
}

model CustomerPayoutBank {
  id            String   @id @default(cuid())
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  currency      String
  bankName      String
  accountName   String
  accountNumber String
  isDefault     Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Order {
  id                       String              @id @default(cuid())
  customerId               String
  customer                 Customer            @relation(fields: [customerId], references: [id])
  // T — immutable attribution snapshot taken at Order creation; history never
  // changes even if the customer's assignment is later corrected by Admin.
  partnerId                String?
  // FROZEN PAYMENT DATA (dynamic QR V1): memo generated ONCE at Order
  // creation from the then-current template; later template changes never
  // rewrite an existing Order's payment instructions.
  transferMemo             String?
  sourceCurrency           String
  targetCurrency           String
  sourceAmount             Decimal             @db.Decimal(18, 6)
  targetAmount             Decimal             @db.Decimal(18, 6)
  rate                     Decimal             @db.Decimal(18, 6)
  fee                      Decimal             @db.Decimal(18, 6)
  feeCurrency              String
  receivingAccountId       String?
  receivingAccountSnapshot Json?
  payoutBankSnapshot       Json?
  status                   OrderStatus         @default(WAITING_PAYMENT)
  customerBillFileId       String?
  customerBillSha256       String?
  aiExtractedData          Json?
  payoutBillFileId         String?
  payoutBillSha256         String?
  verifiedByAdminId        String?
  verifiedAt               DateTime?
  payoutByAdminId          String?
  payoutAt                 DateTime?
  completedAt              DateTime?
  storageFolder            String?
  archiveStatus            String?             @default("PENDING")
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  stateHistories           OrderStateHistory[]
  bills                    OrderBillEvidence[]

  @@index([status])
  @@index([customerId])
  @@index([partnerId])
}

model OrderStateHistory {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  actorId    String
  actorRole  String
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([orderId])
}

model OrderBillEvidence {
  id         String   @id @default(cuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileId     String
  filePath   String
  sha256     String
  extracted  Json?
  uploadedBy String
  createdAt  DateTime @default(now())

  @@index([orderId])
  @@index([sha256])
}

model Conversation {
  id          String           @id @default(cuid())
  customerId  String           @unique
  customer    Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  mode        ConversationMode @default(AUTO)
  claimedById String?
  claimedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  messages    Message[]
  notes       InternalNote[]
}

model Message {
  id                  String       @id @default(cuid())
  conversationId      String
  conversation        Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderType          String       // CUSTOMER, AI, BOT, CSKH, ADMIN, SYSTEM
  senderId            String?
  content             String
  originalAudioFileId String?
  originalAudioSha256 String?
  translatedContent   String?
  deliveryStatus      String       @default("SENT") // PENDING, SENT, FAILED
  telegramMessageId   Int?
  deliveryError       String?
  createdAt           DateTime     @default(now())

  @@index([conversationId])
}

model InternalNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  content        String
  createdAt      DateTime     @default(now())
}

model StaffUser {
  id          String      @id @default(cuid())
  telegramId  String      @unique
  name        String
  role        StaffRole   @default(CSKH)
  status      StaffStatus @default(PENDING)
  permissions String[]    @default([])
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actorRole  String
  action     String
  targetType String
  targetId   String
  details    Json?
  createdAt  DateTime @default(now())
}

model FileEvidence {
  id                  String   @id @default(cuid())
  fileName            String
  filePath            String
  storageRelativePath String?
  fileType            String
  fileSize            Int
  mimeType            String
  sha256              String
  createdAt           DateTime @default(now())

  @@index([sha256])
}

model StaffInvite {
  id                  String    @id @default(cuid())
  code                String    @unique
  role                StaffRole @default(CSKH)
  createdBy           String
  claimedByTelegramId String?
  claimedByName       String?
  status              String    @default("PENDING")
  expiresAt           DateTime
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model BackupRun {
  id             String    @id @default(cuid())
  requestedBy    String    @default("SYSTEM")
  requestedAt    DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?
  status         String    @default("QUEUED") // QUEUED, RUNNING, SUCCESS, FAILED
  snapshotId     String?
  backupType     String    @default("FULL")
  repositoryType String    @default("RESTIC")
  filesCount     Int?
  error          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}

model SystemSecret {
  id             String   @id @default(cuid())
  key            String   @unique
  encryptedValue String
  iv             String
  authTag        String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      String
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdminInputSession {
  id        String   @id @default(cuid())
  staffId   String   @unique
  action    String
  step      String
  payload   Json?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([expiresAt])
}

// ===========================================================================
// Partner / CTV core (S–W). Attribution-only: Partners NEVER see customer
// financial/private data. Commissions are created idempotently on COMPLETED
// orders (unique orderId) and settled in Admin batches.
// ===========================================================================
model Partner {
  id                  String              @id @default(cuid())
  referralCode        String              @unique
  telegramId          String?             @unique
  displayName         String
  status              String              @default("ACTIVE") // ACTIVE | DISABLED
  // Commission configuration (U). spreadSharePercent is reserved for the
  // DEFERRED spread bonus; commission engine currently applies base only.
  baseCommissionUsd   Decimal             @default(1) @db.Decimal(18, 6)
  spreadSharePercent  Decimal             @default(0) @db.Decimal(9, 4)
  holdHours           Int                 @default(72)
  // Partner's OWN payout metadata (safe — this is partner money, not
  // customer data).
  payoutBankName      String?
  payoutAccountNumber String?
  payoutAccountName   String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  commissions         Commission[]
  settlements         PartnerSettlement[]
}

model Commission {
  id                String            @id @default(cuid())
  orderId           String            @unique
  partnerId         String
  partner           Partner           @relation(fields: [partnerId], references: [id])
  baseCommissionUsd Decimal           @db.Decimal(18, 6)
  spreadBonusUsd    Decimal           @default(0) @db.Decimal(18, 6)
  totalUsd          Decimal           @db.Decimal(18, 6)
  status            String            @default("HELD") // HELD | AVAILABLE | PAID | REVERSED
  availableAt       DateTime?
  riskFlag          String?
  settlementId      String?
  settlement        PartnerSettlement? @relation(fields: [settlementId], references: [id])
  paidAt            DateTime?
  reversedReason    String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([partnerId, status])
}

model PartnerSettlement {
  id          String       @id @default(cuid())
  partnerId   String
  partner     Partner      @relation(fields: [partnerId], references: [id])
  totalUsd    Decimal      @db.Decimal(18, 6)
  itemCount   Int
  status      String       @default("PENDING") // PENDING | PAID
  paidAt      DateTime?
  createdBy   String
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  commissions Commission[]
}
