{
  "name": "kh-vn-exchange-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Telegram-first currency exchange operations bot for USD/VND/KHR with Admin, CSKH, AI assistance and audit trail.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "prisma generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/express": "^5.0.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "grammy": "^1.38.0",
    "pg": "^8.16.0",
    "pino": "^9.0.0",
    "prisma": "^7.10.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
