NODE_ENV=production
PORT=3000
TELEGRAM_BOT_TOKEN=
SUPER_ADMIN_TELEGRAM_ID=
# Use your own numeric Telegram ID for private admin notifications initially.
ADMIN_NOTIFICATION_CHAT_ID=
# scripts/configure-vps.py generates a random hex password; do not change on existing DB casually.
POSTGRES_PASSWORD=
DATABASE_URL=
STORAGE_ROOT=/data/KH-VN-EXCHANGE
DATA_DIR=/data/KH-VN-EXCHANGE
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
DEFAULT_SERVICE_FEE_USD=2
MAX_UPLOAD_MB=10
QUOTE_EXPIRY_MINUTES=3
PAYMENT_WAIT_ALERT_MINUTES=30
LARGE_TRANSACTION_THRESHOLD_USD=5000
LOG_LEVEL=info
TIMEZONE=Asia/Phnom_Penh
