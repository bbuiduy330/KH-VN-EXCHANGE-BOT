NODE_ENV=production
PORT=3000
# Canonical application DISPLAY timezone (UTC+07:00). All human-facing
# timestamps are rendered in this zone (see src/shared/app-time.ts).
TIMEZONE=Asia/Ho_Chi_Minh

# =============================================================================
# REQUIRED BOOTSTRAP VALUES — first-install.sh prompts for these; production
# startup FAILS FAST (clear error) if any [REQUIRED] value below is empty.
# =============================================================================
# [REQUIRED] Bot token from @BotFather:
TELEGRAM_BOT_TOKEN=
# [REQUIRED] NUMERIC Telegram user ID of the initial Super Admin — identity
# is the numeric ID, NEVER a @username:
SUPER_ADMIN_TELEGRAM_ID=
# [REQUIRED] PostgreSQL bootstrap secret. Generate: openssl rand -hex 32
# (Under docker compose the deploy scripts inject DATABASE_URL automatically —
# leave DATABASE_URL empty in .env.)
POSTGRES_PASSWORD=
# [REQUIRED in production] Master key for SystemSecret encryption.
# Generate: openssl rand -hex 32
CONFIG_ENCRYPTION_KEY=

# --- OPTIONAL (manageable later from the Telegram Admin UI) ------------------
# Admin notification chat (defaults to the Super Admin private chat):
ADMIN_NOTIFICATION_CHAT_ID=
# Gemini AI assistant — OPTIONAL: the bot still works without it
# (deterministic replies + human support only):
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# Runtime tuning (defaults are sensible):
DEFAULT_SERVICE_FEE_USD=2
MAX_UPLOAD_MB=10
PAYMENT_WAIT_ALERT_MINUTES=30
LARGE_TRANSACTION_THRESHOLD_USD=5000
LOG_LEVEL=info
# Storage paths (Docker default shown; keep as-is for compose deployment):
STORAGE_ROOT=/data/KH-VN-EXCHANGE
DATA_DIR=/data/KH-VN-EXCHANGE
